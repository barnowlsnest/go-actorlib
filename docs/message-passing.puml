@startuml message-passing
!theme plain
skinparam backgroundColor #FFFFFF

title Actor Model Message Passing Pattern

participant "Sender Goroutine" as sender
participant "Ref<T>" as ref
participant "Input Channel" as channel
participant "Stop Channel" as stopchan
participant "Actor Goroutine" as actor
participant "Middleware Chain" as middleware
participant "BehaviorStack" as behavior
participant "Entity State" as entity
participant "Result Channel" as result

note over sender, result : Asynchronous Message Passing via Ref (Typed Actor Handle)

== Message Creation ==
sender -> sender : cmd := command.New(delegateFn)
activate sender

== Message Sending (via Ref) ==
sender -> ref : ref.Send(ctx, cmd)
activate ref
ref -> channel : actor.Receive(ctx, cmd)
note right : Non-blocking if buffer available\nBlocks if buffer full (backpressure)

alt Buffer Available
  channel --> ref : success
  ref --> sender : nil
  deactivate ref
  sender -> result : listen on cmd.Done()
  deactivate sender
else Buffer Full & Timeout
  channel --> ref : ErrActorReceiveTimeout
  ref --> sender : error
  deactivate ref
  deactivate sender
else Stop Channel Closed / Actor Exiting
  stopchan --> ref : actor stopping
  ref --> sender : ErrActorReceiveOnStopped
  deactivate ref
  deactivate sender
end

== Message Processing (Actor Goroutine) ==
activate actor
loop Processing Loop
  actor -> actor : select {\n  case msg := <-input:\n  case <-stop: exit\n}

  alt Message Received
    actor -> middleware : chain(ctx, msg, entity)
    activate middleware
    middleware -> behavior : Current()(ctx, msg, entity)
    activate behavior
    behavior -> entity : execute on entity
    activate entity

    alt Success
      entity -> entity : modify state
      entity --> result : send result
      deactivate entity
    else Error
      entity --> result : close with error
      deactivate entity
    else Panic
      middleware -> middleware : Recovery catches panic
      note right : Prevents Panicked state\nif Recovery middleware active.\nOtherwise: Panicked, loop exits
    end

    deactivate behavior
    deactivate middleware

  else Stop Signal / ctx done / panic
    actor -> actor : drain mailbox
    note right : close(exiting); reject new sends;\nCancel(ErrActorCommandDropped)\non queued Cancelable commands
    actor -> actor : transition to terminal state
    note right : close(done channel)
  end
end
deactivate actor

== Result Consumption ==
activate sender
sender -> result : <-cmd.Done()
alt Success
  result --> sender : result value
else Error/Timeout
  result --> sender : channel closed
  sender -> sender : check cmd.Error()
end
deactivate sender

note over actor, entity
  **Isolated State Access**
  Only actor goroutine accesses entity state.
  Middleware and behavior handlers run
  within the actor's goroutine.
end note

note over channel
  **Bounded Channel**
  Provides backpressure
  and flow control.
  Size: WithInputBufferSize()
end note

note over stopchan
  **Stop Channel**
  Closed by Stop() via
  atomic CAS. Signals
  both processing loop
  and Receive helpers.
end note

== Ask Pattern (Simplified via Ref) ==

participant "Caller" as caller

activate caller
caller -> ref : ref.Ask(ctx, fn, timeout)
ref -> ref : cmd := command.New(fn)
ref -> channel : Send → actor.Receive(ctx, cmd)
channel --> ref : success
ref -> ref : ask.Await(ctx, cmd, timeout)

alt Result Ready
  result --> caller : (R, nil)
else Delegate Error
  result --> caller : (zero, error)
else Context Cancelled
  caller --> caller : (zero, ctx.Err())
else Timeout
  caller --> caller : (zero, ErrAskTimeout)
end
deactivate caller

note over caller : "ref.Ask wraps command\ncreation, ref.Send, ask.Await,\nand error check into one call"

@enduml
